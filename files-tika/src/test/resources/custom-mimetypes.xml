<?xml version="1.0" encoding="UTF-8"?>
<!-- An app-defined type, to check TikaFileScanner picks up custom-mimetypes.xml like Tika's default does. -->
<mime-info>
  <mime-type type="application/x-lk-test">
    <alias type="application/x-lk-test-alias"/>
    <magic priority="50">
      <match value="LKTEST" type="string" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
